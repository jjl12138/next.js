# 复制成 .env 后按需修改（.env 已在 .gitignore 里，不会进仓库）
#
# ⚠️ api-key 等同于账号密码：只放在服务端，别写进 client 代码、别提交。
#    下面这些变量只被 runtimeConfig.imageSaas 读取，不会出现在浏览器里。

# image-saas（Next.js）地址，末尾不要带 /api
NUXT_IMAGE_SAAS_BASE_URL=http://localhost:3000

# image-saas → 设置 → API Key 里创建
NUXT_IMAGE_SAAS_API_KEY=

# 示例页 / 冒烟接口默认使用的应用 id（可选）
NUXT_IMAGE_SAAS_DEFAULT_APP_ID=
